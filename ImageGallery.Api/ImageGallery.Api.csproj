<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <UserSecretsId>imagegallery-api-secrets</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cliente oficial do Supabase para .NET (Postgrest + Gotrue + Storage) -->
    <PackageReference Include="Supabase" Version="1.1.1" />

    <!-- Autenticação via JWT emitido pelo Supabase Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- Processamento de imagem (thumbnail, validação, dimensões) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

    <!-- Documentação OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
